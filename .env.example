# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Leave both empty to run the local demo mode (browser storage, demo accounts).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Google "Sign in with Google" button (Google Cloud → APIs & Services → Credentials → Web client ID).
# Same client ID as in Supabase → Authentication → Providers → Google. Leave empty to use the redirect flow.
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
